<!doctype html>
<html lang="en">
<head>
{% set default_theme = "dark" %}
{% include "_head.html" %}
<meta name="theme-color" content="#0a0a0d" />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
    :root {
        --bg: #0a0a0d; --tile: #131318; --tile2: #1b1b22; --line: #26262f; --ink: #ededf0; --mute: #a0a0ac;
        --accent: #5eead4; --accent2: #8ab4ff; --accent-ink: #06201b; --warn: #ff9f9f;
        --sans: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        --r: 22px;
    }
    [data-theme="light"] {
        --bg: #eceef3; --tile: #ffffff; --tile2: #f3f4f8; --line: #dde0e8; --ink: #14151a; --mute: #565a66;
        --accent: #0b7a67; --accent2: #2b59d9; --accent-ink: #ffffff; --warn: #b42318;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 1rem; line-height: 1.6; min-height: 100vh; transition: background-color .25s, color .25s; }
    body::before { content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background: radial-gradient(60rem 40rem at 8% -10%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 60%),
                    radial-gradient(55rem 40rem at 105% 105%, color-mix(in srgb, var(--accent2) 12%, transparent), transparent 60%); }
    a { color: inherit; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
    body:has(dialog[open]) { overflow: hidden; }
    .mono { font-family: var(--mono); font-size: .72rem; letter-spacing: .04em; }
    .up { text-transform: uppercase; letter-spacing: .08em; color: var(--mute); }

    .grid { max-width: 1180px; margin: 0 auto; padding: 1.4rem 1.2rem 3rem; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 14px; grid-auto-flow: dense; }
    .t { background: var(--tile); border: 1px solid var(--line); border-radius: var(--r); padding: 1.5rem; position: relative; overflow: hidden; transition: border-color .2s, transform .2s, background-color .25s; min-width: 0; }
    .t h2 { font-size: 1.15rem; font-weight: 700; letter-spacing: -.01em; margin-bottom: .8rem; }
    .s4 { grid-column: span 4; } .s5 { grid-column: span 5; } .s6 { grid-column: span 6; } .s7 { grid-column: span 7; } .s8 { grid-column: span 8; } .s12 { grid-column: span 12; }
    .r2 { grid-row: span 2; }

    /* intro + links */
    .intro { padding: 2rem; display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
    .who { display: flex; align-items: center; gap: .9rem; }
    .who img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line); }
    .who h1 { font-size: 1.05rem; font-weight: 700; line-height: 1.2; }
    .who span { color: var(--mute); font-size: .9rem; }
    .lead { font-size: clamp(1.7rem, 3.5vw, 2.7rem); line-height: 1.14; font-weight: 600; letter-spacing: -.03em; max-width: 20em; }
    .lead em { font-style: normal; background: linear-gradient(100deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .where { color: var(--mute); }
    .linkrows a { display: flex; justify-content: space-between; align-items: center; padding: .7rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
    .linkrows a:hover { color: var(--accent); }
    .linkrows a span:last-child { color: var(--mute); }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; background: var(--accent); color: var(--accent-ink); font-weight: 700; border: 0; border-radius: 999px; padding: .7rem 1.2rem; text-decoration: none; cursor: pointer; font-family: inherit; font-size: .95rem; }
    .btn:hover { filter: brightness(1.08); }
    .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); font-weight: 600; }
    .btn.ghost:hover { border-color: var(--accent); color: var(--accent); filter: none; }
    .tbtn { background: none; border: 1px solid var(--line); border-radius: 999px; color: var(--mute); font-family: var(--mono); font-size: .7rem; padding: .3rem .8rem; cursor: pointer; margin-top: 1rem; }
    .tbtn:hover { color: var(--ink); border-color: var(--mute); }

    /* project tiles */
    .proj { cursor: pointer; display: flex; flex-direction: column; gap: .6rem; }
    .proj:hover { border-color: var(--accent); transform: translateY(-2px); }
    .pill { align-self: flex-start; font-family: var(--mono); font-size: .66rem; letter-spacing: .05em; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); border-radius: 999px; padding: .12rem .6rem; }
    .proj h3 { font-size: 1.55rem; font-weight: 750; letter-spacing: -.03em; line-height: 1.1; }
    .proj .tag { color: var(--mute); font-size: .95rem; margin-top: -.3rem; }
    .proj .find { color: var(--ink); opacity: .86; font-size: .95rem; }
    .proj .more { margin-top: auto; padding-top: .6rem; font-weight: 700; color: var(--accent); background: none; border: 0; text-align: left; font-family: inherit; font-size: .92rem; cursor: pointer; }
    .proj .more::after { content: " →"; }
    .collage { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin: -.2rem -.2rem .4rem; }
    .collage img { width: 100%; height: auto; display: block; border-radius: 12px; }
    .toprow { display: flex; justify-content: space-between; align-items: center; }
    .num { font-family: var(--mono); font-size: .7rem; color: var(--mute); }
    .stack.mini { margin-top: .3rem; }

    /* lists in tiles */
    .also a { display: block; padding: .75rem 0; border-top: 1px solid var(--line); text-decoration: none; }
    .also a:first-of-type { border-top: 0; padding-top: 0; }
    .also b { display: block; font-weight: 700; }
    .also span { color: var(--mute); font-size: .9rem; }
    .also a:hover b { color: var(--accent); }
    .job { padding: .9rem 0; border-top: 1px solid var(--line); }
    .job:first-of-type { border-top: 0; padding-top: 0; }
    .job h3 { font-size: 1rem; font-weight: 700; }
    .job .org { color: var(--accent); }
    .job .d { color: var(--mute); display: block; margin-bottom: .1rem; }
    .job ul { margin: .4rem 0 0 1.1rem; color: var(--mute); font-size: .93rem; }
    .sk { padding: .7rem 0; border-top: 1px solid var(--line); }
    .sk:first-of-type { border-top: 0; padding-top: 0; }
    .sk h3 { margin-bottom: .15rem; }
    .sk p { color: var(--mute); font-size: .93rem; }
    .about p { color: var(--mute); margin-bottom: .8rem; }
    .about p:first-of-type { color: var(--ink); font-size: 1.15rem; line-height: 1.4; font-weight: 500; }
    .about strong { color: var(--ink); }
    .mail { display: block; font-size: clamp(1.25rem, 2.6vw, 2rem); font-weight: 750; letter-spacing: -.03em; line-height: 1.15; overflow-wrap: anywhere; text-decoration: none; margin: .2rem 0 1.2rem; }
    .mail:hover { color: var(--accent); }
    .row { display: flex; flex-wrap: wrap; gap: .6rem; }
    footer { grid-column: 1 / -1; text-align: center; color: var(--mute); padding-top: 1rem; }

    /* case-study dialog */
    dialog.case { width: min(860px, 94vw); max-height: 90vh; margin: auto; padding: 0; border: 1px solid var(--line); border-radius: 26px; background: var(--tile); color: var(--ink); overflow: auto; }
    dialog.case::backdrop { background: rgba(0, 0, 0, .62); backdrop-filter: blur(5px); }
    .dh { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: 1rem; padding: 1rem 1.4rem; background: color-mix(in srgb, var(--tile) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
    .dh h3 { font-size: 1.15rem; font-weight: 750; letter-spacing: -.02em; margin-right: auto; }
    .dh h3 span { color: var(--mute); font-weight: 500; font-size: .95rem; }
    .x { background: var(--tile2); border: 1px solid var(--line); color: var(--ink); width: 2.2rem; height: 2.2rem; border-radius: 50%; cursor: pointer; font-size: 1.1rem; line-height: 1; }
    .x:hover { border-color: var(--accent); color: var(--accent); }
    .db { padding: 1.4rem 1.6rem 2rem; }
    .db .problem { font-size: 1.25rem; line-height: 1.35; font-weight: 500; letter-spacing: -.01em; margin-bottom: 1rem; max-width: 36em; }
    .dl { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.4rem; }
    .dl a { text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: .3rem .85rem; font-size: .85rem; }
    .dl a:hover { border-color: var(--accent); color: var(--accent); }
    .pipe { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; margin-bottom: .4rem; }
    .pipe li { background: var(--tile2); border: 1px solid var(--line); border-radius: 999px; padding: .15rem .75rem; font-size: .8rem; color: var(--mute); }
    .pipe li.hl { color: var(--ink); border-color: var(--accent); }
    .cap { font-family: var(--mono); font-size: .68rem; color: var(--mute); margin-bottom: 1.3rem; }
    .gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-bottom: .4rem; }
    .gal img { width: 100%; height: auto; display: block; border-radius: 14px; }
    .part { margin-bottom: 1.2rem; max-width: 42em; }
    .part h4 { font-family: var(--mono); font-size: .7rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: .25rem; }
    .part p { color: var(--mute); }
    .part strong { color: var(--ink); font-weight: 700; }
    .fail { border-radius: 16px; background: color-mix(in srgb, var(--warn) 10%, transparent); border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent); padding: 1rem 1.2rem 1.1rem; margin: 1.4rem 0; max-width: 42em; }
    .fail h4 { font-family: var(--mono); font-size: .7rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--warn); margin-bottom: .25rem; }
    .stack { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; }
    .stack li { font-family: var(--mono); font-size: .68rem; background: var(--tile2); border: 1px solid var(--line); border-radius: 999px; padding: .1rem .6rem; color: var(--mute); }

    @media (max-width: 900px) {
        .grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        .s4, .s5, .s6, .s7, .s8 { grid-column: span 6; }
        .r2 { grid-row: auto; }
        .intro { gap: 1.4rem; }
    }
    @media (max-width: 520px) {
        .grid { padding: 1rem .8rem 2rem; }
        .t { padding: 1.2rem; }
        .db { padding: 1.1rem 1.1rem 1.6rem; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
</style>
</head>
<body>
<main class="grid">
    <section class="t s8 intro" aria-label="Introduction">
        <div class="who">
            <img src="{{ P.avatar }}" width="480" height="480" alt="Portrait of {{ P.name }}" />
            <div><h1>{{ P.name }}</h1><span>{{ P.role }}</span></div>
        </div>
        <p class="lead">{{ P.lead.replace(P.lead_em, '<em>' ~ P.lead_em ~ '</em>')|safe }}</p>
        <p class="where mono">{{ P.where }}</p>
    </section>

    <aside class="t s4" aria-label="Links">
        <p class="up mono" style="margin-bottom:.6rem">Elsewhere</p>
        <a class="btn" href="{{ P.resume }}" download style="width:100%;margin-bottom:.9rem">Download resume (PDF) ↓</a>
        <nav class="linkrows" aria-label="Profiles">
            <a href="{{ P.github }}" target="_blank" rel="noopener"><span>GitHub</span><span>↗</span></a>
            <a href="{{ P.linkedin }}" target="_blank" rel="noopener"><span>LinkedIn</span><span>↗</span></a>
            <a href="mailto:{{ P.email }}"><span>Email</span><span>↗</span></a>
        </nav>
        <button class="tbtn" id="themeToggle" type="button" aria-label="Switch colour theme"><span id="themeLabel">Light</span></button>
    </aside>

    {% for p in PROJECTS %}
    {% set span = 's7 r2' if loop.first else ('s5' if loop.index in (2, 3, 4) else 's5') %}
    <article class="t proj {{ span }}" data-open="{{ p.id }}" id="card-{{ p.id }}">
        {% if p.gallery %}<div class="collage">{% for src, alt in p.gallery %}<img src="{{ src }}" width="640" height="640" loading="lazy" alt="{{ alt }}" />{% endfor %}</div>{% endif %}
        <div class="toprow"><span class="pill">{{ p.kind }}</span><span class="num">{{ p.n }}</span></div>
        <h3>{{ p.name }}</h3>
        <p class="tag">{{ p.tag }}</p>
        <p class="find">{{ p.find }}</p>
        {% if not p.gallery %}<ul class="stack mini">{% for s in p.stack[:5] %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}
        <button class="more" type="button" data-open="{{ p.id }}" aria-haspopup="dialog">Read the case study</button>
    </article>
    {% endfor %}

    <section class="t s7 also" aria-label="Also built">
        <h2>Also built</h2>
        {% for a in ALSO %}<a href="{{ a.url }}" target="_blank" rel="noopener"><b>{{ a.name }} ↗</b><span>{{ a.text }}</span></a>{% endfor %}
    </section>

    <section class="t s7" id="experience" aria-label="Experience">
        <h2>Where I have worked</h2>
        {% for e in EXPERIENCE %}
        <div class="job"><span class="d mono">{{ e.when }} · {{ e.place }}</span><h3>{{ e.role }} <span class="org">· {{ e.org }}</span></h3>
            <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul></div>
        {% endfor %}
    </section>

    <section class="t s5" id="skills" aria-label="Skills">
        <h2>What I work with</h2>
        {% for label, text in SKILLS %}<div class="sk"><h3 class="up mono">{{ label }}</h3><p>{{ text }}</p></div>{% endfor %}
    </section>

    <section class="t s5 about" id="about" aria-label="About">
        <h2>What I care about</h2>
        {% for para in ABOUT %}<p>{{ para|safe }}</p>{% endfor %}
    </section>

    <section class="t s7" id="contact" aria-label="Contact">
        <h2>Say hello</h2>
        <a class="mail" href="mailto:{{ P.email }}">{{ P.email }}</a>
        <div class="row">
            <a class="btn" href="{{ P.resume }}" download>Resume (PDF) ↓</a>
            <a class="btn ghost" href="{{ P.github }}" target="_blank" rel="noopener">GitHub ↗</a>
            <a class="btn ghost" href="{{ P.linkedin }}" target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
    </section>

    <footer class="mono">M. Ahmad Siddiqui · ML Engineer · Updated October 2026</footer>
</main>

{% for p in PROJECTS %}
<dialog class="case" id="dlg-{{ p.id }}" aria-labelledby="h-{{ p.id }}">
    <div class="dh">
        <h3 id="h-{{ p.id }}">{{ p.name }} <span>{{ p.tag }}</span></h3>
        <button class="x" type="button" data-close aria-label="Close case study">×</button>
    </div>
    <div class="db">
        <p class="problem">{{ p.problem }}</p>
        <div class="dl">{% for label, url in p.links %}<a href="{{ url }}" target="_blank" rel="noopener">{{ label }} ↗</a>{% endfor %}</div>
        {% if p.steps %}
        <ol class="pipe" aria-label="Pipeline">{% for text, hl in p.steps %}<li{% if hl %} class="hl"{% endif %}>{{ text }}</li>{% endfor %}</ol>
        <p class="cap">{{ p.steps_caption }}</p>
        {% endif %}
        {% if p.gallery %}
        <div class="gal">{% for src, alt in p.gallery %}<img src="{{ src }}" width="640" height="640" loading="lazy" alt="{{ alt }}" />{% endfor %}</div>
        <p class="cap">{{ p.gallery_caption }}</p>
        {% endif %}
        <div class="part"><h4>Built</h4><p>{{ p.built|safe }}</p></div>
        <div class="part"><h4>Measured</h4><p>{{ p.measured|safe }}</p></div>
        <div class="fail" role="note"><h4>Did not work</h4><p>{{ p.fail }}</p></div>
        {% if p.limits %}<div class="part"><h4>Limits</h4><p>{{ p.limits }}</p></div>{% endif %}
        <ul class="stack">{% for s in p.stack %}<li>{{ s }}</li>{% endfor %}</ul>
    </div>
</dialog>
{% endfor %}

{% include "_scripts.html" %}
<script>
    (function () {
        function open(id) { var d = document.getElementById("dlg-" + id); if (d && !d.open) d.showModal(); }
        document.querySelectorAll("[data-open]").forEach(function (el) {
            el.addEventListener("click", function (e) {
                if (e.target.closest("a")) return;
                open(el.getAttribute("data-open"));
                try { history.replaceState(null, "", "#" + el.getAttribute("data-open")); } catch (x) {}
            });
        });
        document.querySelectorAll("dialog.case").forEach(function (d) {
            d.addEventListener("click", function (e) { if (e.target === d) d.close(); });
            d.addEventListener("close", function () { try { history.replaceState(null, "", location.pathname + location.search); } catch (x) {} });
            d.querySelector("[data-close]").addEventListener("click", function () { d.close(); });
        });
        if (location.hash) open(location.hash.slice(1));
        window.addEventListener("hashchange", function () { if (location.hash) open(location.hash.slice(1)); });
    })();
</script>
</body>
</html>
