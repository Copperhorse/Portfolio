<!doctype html>
<html lang="en">
<head>
{% set default_theme = "dark" %}
{% include "_head.html" %}
<meta name="theme-color" content="#0d1117" />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />
<style>
    :root {
        --bg: #0d1117; --bar: #161b22; --fg: #d0d7de; --dim: #8b949e; --line: #30363d;
        --green: #3fb950; --cyan: #79c0ff; --amber: #e3b341; --red: #ff7b72; --purple: #d2a8ff;
        --sel: rgba(121,192,255,.14);
        --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    }
    [data-theme="light"] {
        --bg: #fbf7ee; --bar: #efe9da; --fg: #33404a; --dim: #66737c; --line: #d6cfbd;
        --green: #1a7f37; --cyan: #0b5fb8; --amber: #8a5a00; --red: #c2312a; --purple: #7a42c4;
        --sel: rgba(11,95,184,.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 4rem; }
    body { background: var(--bg); color: var(--fg); font: 400 15px/1.75 var(--mono); transition: background-color .25s, color .25s; }
    a { color: var(--cyan); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 3px; }
    :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
    ::selection { background: var(--sel); }
    strong { color: var(--fg); font-weight: 700; }

    .bar { position: fixed; inset: 0 0 auto 0; z-index: 50; background: var(--bar); border-bottom: 1px solid var(--line); }
    .bar-in { max-width: 920px; margin: 0 auto; padding: 0 1.25rem; height: 2.9rem; display: flex; align-items: center; gap: 1rem; }
    .dots { display: flex; gap: .4rem; }
    .dots i { width: .72rem; height: .72rem; border-radius: 50%; display: block; }
    .dots i:nth-child(1) { background: #ff5f56; } .dots i:nth-child(2) { background: #ffbd2e; } .dots i:nth-child(3) { background: #27c93f; }
    .title { color: var(--dim); font-size: .78rem; margin-right: auto; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tabs { display: flex; gap: 1rem; font-size: .76rem; }
    .tabs a { color: var(--dim); }
    .tabs a:hover { color: var(--fg); text-decoration: none; }
    .tabs a[aria-current="true"] { color: var(--green); }
    .tbtn { background: none; border: 1px solid var(--line); color: var(--dim); font: inherit; font-size: .72rem; padding: .2rem .55rem; cursor: pointer; }
    .tbtn:hover { color: var(--fg); }

    main { max-width: 920px; margin: 0 auto; padding: 5.2rem 1.25rem 4rem; }
    section { margin-bottom: 3.6rem; }
    .cmd { margin: 0 0 .7rem; font-weight: 500; }
    .ps { color: var(--green); font-weight: 700; }
    .path { color: var(--cyan); }
    .dol { color: var(--dim); }
    .arg { color: var(--fg); }
    .cmt { color: var(--dim); }
    .out { margin: 0 0 1rem; max-width: 74ch; }
    .lead { font-size: clamp(1.15rem, 2.6vw, 1.5rem); line-height: 1.5; color: var(--fg); font-weight: 500; }
    .lead em { color: var(--amber); font-style: normal; }
    .dim { color: var(--dim); }

    details.proj { border-top: 1px dashed var(--line); }
    details.proj:last-of-type { border-bottom: 1px dashed var(--line); }
    details.proj > summary { list-style: none; cursor: pointer; padding: .95rem 0; display: grid; grid-template-columns: 1.1rem 6.5rem minmax(0, 1fr); gap: .1rem .6rem; align-items: baseline; }
    details.proj > summary::-webkit-details-marker { display: none; }
    .car::before { content: "▸"; color: var(--dim); }
    details[open] .car::before { content: "▾"; color: var(--green); }
    .pn { color: var(--cyan); font-weight: 700; }
    .pf { color: var(--dim); font-size: .88rem; }
    details[open] .pf { display: none; }
    details.proj > summary:hover .pn { text-decoration: underline; text-underline-offset: 4px; }
    .pbody { padding: .2rem 0 1.8rem 1.7rem; border-left: 1px dashed var(--line); margin-left: .35rem; padding-left: 1.3rem; }
    .pbody .cmd { margin-top: .2rem; }
    .lnk { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; margin: .5rem 0 1.2rem; font-size: .86rem; }
    h4 { font-size: .82rem; font-weight: 700; margin: 1.3rem 0 .25rem; letter-spacing: .02em; }
    h4.b { color: var(--purple); } h4.m { color: var(--green); } h4.l { color: var(--dim); }
    .blk p { max-width: 74ch; }
    .err { margin: 1.4rem 0; padding: .8rem 1rem .9rem; border-left: 3px solid var(--red); background: color-mix(in srgb, var(--red) 9%, transparent); max-width: 74ch; }
    .err h4 { color: var(--red); margin: 0 0 .25rem; }
    .pipe { display: flex; flex-wrap: wrap; gap: .15rem .5rem; margin: .4rem 0 .3rem; font-size: .82rem; color: var(--dim); }
    .pipe span { color: var(--fg); }
    .pipe span.hl { color: var(--amber); }
    .pipe span:not(:last-child)::after { content: " |"; color: var(--dim); margin-left: .5rem; }
    .cap { font-size: .76rem; color: var(--dim); margin-bottom: 1rem; }
    .gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin: .5rem 0 .3rem; }
    .gal img { width: 100%; height: auto; display: block; border: 1px solid var(--line); border-radius: 3px; }
    .arr { color: var(--fg); font-size: .84rem; }
    .arr b { color: var(--green); font-weight: 400; }

    .kv { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: .1rem 1.2rem; margin-bottom: .8rem; }
    .kv dt { color: var(--purple); } .kv dd { color: var(--fg); }
    .log { display: grid; grid-template-columns: 11.5rem minmax(0, 1fr); gap: 0 1.2rem; margin-bottom: 1.4rem; }
    .log .d { color: var(--dim); font-size: .86rem; padding-top: .1rem; }
    .log b { color: var(--cyan); font-weight: 700; } .log .o { color: var(--amber); }
    .log ul { list-style: none; margin-top: .25rem; }
    .log li::before { content: "- "; color: var(--dim); }
    .log li { margin-bottom: .15rem; }
    .also { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: .1rem 1.2rem; padding: .7rem 0; border-top: 1px dashed var(--line); }
    .also:last-of-type { border-bottom: 1px dashed var(--line); }
    .also .k { color: var(--dim); font-size: .8rem; padding-top: .15rem; }
    .also b { color: var(--cyan); }
    .cur { display: inline-block; width: .6em; height: 1.05em; background: var(--green); vertical-align: -.17em; animation: blink 1.1s steps(2, start) infinite; }
    @keyframes blink { to { visibility: hidden; } }
    footer { color: var(--dim); font-size: .74rem; border-top: 1px solid var(--line); padding-top: 1.2rem; }

    @media (max-width: 720px) {
        .title { display: none; } .tabs { margin-left: auto; gap: .7rem; } .tabs a.x { display: none; }
        details.proj > summary { grid-template-columns: 1.1rem minmax(0, 1fr); }
        .pf { grid-column: 2; }
        .pbody { padding-left: .9rem; }
        .kv, .log, .also { grid-template-columns: 1fr; }
        .kv dt, .log .d, .also .k { margin-top: .5rem; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .cur { animation: none; } * { transition: none !important; } }
</style>
</head>
<body>
<header class="bar">
    <div class="bar-in">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="title">ahmad@siddiqui: ~/portfolio</span>
        <nav class="tabs" aria-label="Sections">
            <a href="#work">[1]work</a><a href="#experience" class="x">[2]log</a><a href="#skills" class="x">[3]skills</a><a href="#about" class="x">[4]about</a><a href="#contact">[5]contact</a>
        </nav>
        <button class="tbtn" id="themeToggle" type="button" aria-label="Switch colour theme"><span id="themeLabel">Light</span></button>
    </div>
</header>

<main>
    <section id="top" aria-label="Introduction">
        <p class="cmd"><span class="ps">ahmad@siddiqui</span><span class="dol">:</span><span class="path">~</span><span class="dol">$</span> whoami</p>
        <p class="out lead">{{ P.lead.replace(P.lead_em, '<em>' ~ P.lead_em ~ '</em>')|safe }}</p>
        <p class="out dim"># {{ P.where }}</p>
        <p class="out">
            <span class="dol">next →</span>
            <a href="#work">cd projects/</a> &nbsp;·&nbsp; <a href="{{ P.resume }}" download>wget resume.pdf</a> &nbsp;·&nbsp; <a href="{{ P.github }}" target="_blank" rel="noopener">open github</a>
        </p>
    </section>

    <section id="work">
        <p class="cmd"><span class="ps">ahmad@siddiqui</span><span class="dol">:</span><span class="path">~</span><span class="dol">$</span> ls -1 projects/</p>
        <p class="out dim"># four projects, each with what I measured and what did not work. Open one with enter.</p>
        {% for p in PROJECTS %}
        <details class="proj" id="{{ p.id }}"{% if loop.first %} open{% endif %}>
            <summary><span class="car"></span><span class="pn">{{ p.id }}/</span><span class="pf">{{ p.find }}</span></summary>
            <div class="pbody">
                <p class="cmd"><span class="dol">$</span> cat {{ p.id }}/README.md</p>
                <p class="out"><strong>{{ p.name }}</strong> <span class="dim">— {{ p.tag }}</span></p>
                <p class="out">{{ p.problem }}</p>
                <div class="lnk">{% for label, url in p.links %}<a href="{{ url }}" target="_blank" rel="noopener">↗ {{ label|lower }}</a>{% endfor %}</div>

                {% if p.steps %}
                <div class="pipe" aria-label="Pipeline">{% for text, hl in p.steps %}<span{% if hl %} class="hl"{% endif %}>{{ text }}</span>{% endfor %}</div>
                <p class="cap"># {{ p.steps_caption }}</p>
                {% endif %}
                {% if p.gallery %}
                <div class="gal">{% for src, alt in p.gallery %}<img src="{{ src }}" width="640" height="640" loading="lazy" alt="{{ alt }}" />{% endfor %}</div>
                <p class="cap"># {{ p.gallery_caption }}</p>
                {% endif %}

                <div class="blk"><h4 class="b"># built</h4><p>{{ p.built|safe }}</p></div>
                <div class="blk"><h4 class="m"># measured</h4><p>{{ p.measured|safe }}</p></div>
                <div class="err" role="note"><h4>[stderr] did not work</h4><p>{{ p.fail }}</p></div>
                {% if p.limits %}<div class="blk"><h4 class="l"># limits</h4><p>{{ p.limits }}</p></div>{% endif %}
                <p class="cap" style="margin-top:1.2rem">stack = [{% for s in p.stack %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}]</p>
            </div>
        </details>
        {% endfor %}

        <p class="cmd" style="margin-top:2.2rem"><span class="dol">$</span> ls also-built/</p>
        {% for a in ALSO %}
        <div class="also"><div class="k">{{ a.kind }}</div><div><b>{{ a.name }}</b><br />{{ a.text }} <a href="{{ a.url }}" target="_blank" rel="noopener">↗ github</a></div></div>
        {% endfor %}
    </section>

    <section id="experience">
        <p class="cmd"><span class="ps">ahmad@siddiqui</span><span class="dol">:</span><span class="path">~</span><span class="dol">$</span> cat experience.log</p>
        {% for e in EXPERIENCE %}
        <div class="log">
            <div class="d">{{ e.when }}<br />{{ e.place }}</div>
            <div><b>{{ e.role }}</b> <span class="o">@ {{ e.org }}</span>
                <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul></div>
        </div>
        {% endfor %}
    </section>

    <section id="skills">
        <p class="cmd"><span class="ps">ahmad@siddiqui</span><span class="dol">:</span><span class="path">~</span><span class="dol">$</span> cat skills.yml</p>
        <dl class="kv">
            {% for label, text in SKILLS %}<dt>{{ label|lower|replace(' ', '_') }}:</dt><dd>{{ text }}</dd>{% endfor %}
        </dl>
    </section>

    <section id="about">
        <p class="cmd"><span class="ps">ahmad@siddiqui</span><span class="dol">:</span><span class="path">~</span><span class="dol">$</span> cat about.md</p>
        {% for para in ABOUT %}<p class="out">{{ para|safe }}</p>{% endfor %}
    </section>

    <section id="contact">
        <p class="cmd"><span class="ps">ahmad@siddiqui</span><span class="dol">:</span><span class="path">~</span><span class="dol">$</span> ./contact.sh</p>
        <p class="arr"><b>email    </b> → <a href="mailto:{{ P.email }}">{{ P.email }}</a></p>
        <p class="arr"><b>github   </b> → <a href="{{ P.github }}" target="_blank" rel="noopener">github.com/Copperhorse</a></p>
        <p class="arr"><b>linkedin </b> → <a href="{{ P.linkedin }}" target="_blank" rel="noopener">linkedin.com/in/ahmad-siddiqui-559998267</a></p>
        <p class="arr"><b>resume   </b> → <a href="{{ P.resume }}" download>Ahmad_Siddiqui_Resume.pdf</a></p>
        <p class="cmd" style="margin-top:1.6rem"><span class="ps">ahmad@siddiqui</span><span class="dol">:</span><span class="path">~</span><span class="dol">$</span> <span class="cur" aria-hidden="true"></span></p>
    </section>

    <footer>exit 0 · M. Ahmad Siddiqui · updated October 2026</footer>
</main>
{% include "_scripts.html" %}
<script>
    (function () {
        function openHash() { var el = location.hash && document.querySelector("details" + location.hash); if (el) el.open = true; }
        openHash(); window.addEventListener("hashchange", openHash);
        var tabs = {}; document.querySelectorAll(".tabs a").forEach(function (a) { tabs[a.getAttribute("href").slice(1)] = a; });
        function setActive(id) {
            if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) id = "contact";
            Object.keys(tabs).forEach(function (k) { if (k === id) tabs[k].setAttribute("aria-current", "true"); else tabs[k].removeAttribute("aria-current"); });
        }
        if ("IntersectionObserver" in window) {
            var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) setActive(e.target.id); }); }, { rootMargin: "-30% 0px -60% 0px" });
            ["work", "experience", "skills", "about", "contact"].forEach(function (k) { var s = document.getElementById(k); if (s) io.observe(s); });
            addEventListener("scroll", function () { if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) setActive("contact"); }, { passive: true });
        }
    })();
</script>
</body>
</html>
