<!doctype html>
<html lang="en">
<head>
{% set default_theme = "light" %}
{% include "_head.html" %}
<meta name="theme-color" content="#ece9e0" />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
    :root {
        --bg: #ece9e0; --ink: #0f0f0f; --mute: #57564f; --accent: #ee3f0c; --rule: #0f0f0f; --soft: #dcd8cc;
        --disp: "Bricolage Grotesque", "Helvetica Neue", Arial, sans-serif;
        --mono: "DM Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    }
    [data-theme="dark"] { --bg: #0e0e0e; --ink: #f1eee6; --mute: #a5a39b; --accent: #ff6a3d; --rule: #f1eee6; --soft: #1b1b1b; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }
    body { background: var(--bg); color: var(--ink); font-family: var(--disp); font-size: 1.05rem; line-height: 1.6; font-optical-sizing: auto; transition: background-color .25s, color .25s; }
    a { color: inherit; }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
    ::selection { background: var(--accent); color: var(--bg); }
    .mono { font-family: var(--mono); font-size: .76rem; letter-spacing: .04em; text-transform: uppercase; }
    .wrap { max-width: 1320px; margin: 0 auto; padding: 0 1.75rem; }

    header.top { position: sticky; top: 0; z-index: 40; background: var(--bg); border-bottom: 2px solid var(--rule); }
    .top-in { display: flex; align-items: center; gap: 2rem; height: 3.4rem; }
    .top .brand { font-weight: 800; letter-spacing: -.02em; margin-right: auto; text-decoration: none; font-size: 1.05rem; }
    .top nav { display: flex; gap: 1.6rem; }
    .top nav a { text-decoration: none; }
    .top nav a:hover, .top nav a[aria-current="true"] { color: var(--accent); }
    .tbtn { background: none; border: 2px solid var(--rule); color: inherit; font: inherit; padding: .25rem .6rem; cursor: pointer; }
    .tbtn:hover { background: var(--ink); color: var(--bg); }

    /* hero */
    .hero { padding: clamp(2rem, 5vw, 4rem) 0 0; }
    .hero h1 { font-weight: 800; font-size: clamp(3.8rem, 17.5vw, 16rem); line-height: .8; letter-spacing: -.045em; margin-left: -.04em; }
    .hero h1 span { display: block; }
    .hero h1 .l2 { color: var(--accent); }
    .hero-grid { display: grid; grid-template-columns: 7fr 5fr; gap: 2rem 4rem; padding: 2.4rem 0 2.6rem; }
    .lead { font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.18; font-weight: 500; letter-spacing: -.02em; }
    .lead em { font-style: normal; box-shadow: inset 0 -.38em 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    .meta { display: grid; gap: .9rem; align-content: start; }
    .meta div { border-top: 2px solid var(--rule); padding-top: .55rem; }
    .meta .k { color: var(--mute); display: block; margin-bottom: .15rem; }
    .meta a { text-decoration: none; border-bottom: 2px solid var(--accent); }
    .meta a:hover { background: var(--accent); color: var(--bg); }
    .ticker { border-top: 2px solid var(--rule); border-bottom: 2px solid var(--rule); padding: .7rem 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .ticker b { color: var(--accent); font-weight: 500; padding: 0 .9rem; }

    /* sections */
    section.sec { padding: clamp(3.5rem, 8vw, 6.5rem) 0 0; }
    .sec-h { display: flex; align-items: baseline; gap: 1.2rem; margin-bottom: 2.2rem; flex-wrap: wrap; }
    .sec-h h2 { font-size: clamp(2.2rem, 6.2vw, 5rem); font-weight: 750; line-height: .95; letter-spacing: -.04em; max-width: 14em; }
    .sec-h .mono { color: var(--mute); }

    details.proj { border-top: 2px solid var(--rule); }
    details.proj:last-of-type { border-bottom: 2px solid var(--rule); }
    details.proj > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: clamp(3.4rem, 9vw, 7rem) minmax(0, 1fr) auto 2rem; gap: 0 1.2rem; align-items: center; padding: 1.3rem .6rem; transition: background-color .15s, color .15s; }
    details.proj > summary::-webkit-details-marker { display: none; }
    .pnum { font-size: clamp(2.2rem, 6vw, 5rem); font-weight: 800; letter-spacing: -.05em; line-height: 1; color: var(--mute); }
    .pname { font-size: clamp(1.7rem, 4.6vw, 3.6rem); font-weight: 750; letter-spacing: -.035em; line-height: 1; display: block; }
    .ptag { display: block; margin-top: .35rem; color: var(--mute); font-size: .98rem; letter-spacing: 0; text-transform: none; font-family: var(--disp); }
    .pkind { text-align: right; color: var(--mute); }
    .pm { position: relative; width: 1.4rem; height: 1.4rem; }
    .pm::before, .pm::after { content: ""; position: absolute; left: 0; top: 50%; width: 100%; height: 3px; background: currentColor; transition: transform .2s; }
    .pm::after { transform: rotate(90deg); }
    details[open] .pm::after { transform: rotate(0); }
    details[open] > summary .pnum { color: var(--accent); }
    details.proj > summary:hover { background: var(--ink); color: var(--bg); }
    details.proj > summary:hover .pnum, details.proj > summary:hover .ptag, details.proj > summary:hover .pkind { color: var(--bg); opacity: .8; }
    .pfind { grid-column: 2 / 4; color: var(--mute); margin-top: .5rem; max-width: 46em; }
    details[open] .pfind { display: none; }
    details.proj > summary:hover .pfind { color: var(--bg); opacity: .8; }

    .pbody { display: grid; grid-template-columns: 5fr 7fr; gap: 2rem 4rem; padding: 1.2rem .6rem 3rem; }
    .problem { font-size: 1.35rem; line-height: 1.35; font-weight: 500; letter-spacing: -.01em; margin-bottom: 1.1rem; }
    .btns { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.8rem; }
    .btns a { text-decoration: none; border: 2px solid var(--rule); padding: .4rem .8rem; }
    .btns a:hover { background: var(--ink); color: var(--bg); }
    .part { margin-bottom: 1.5rem; }
    .part h4 { font-family: var(--mono); font-size: .72rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--mute); border-top: 2px solid var(--rule); padding-top: .5rem; margin-bottom: .4rem; }
    .part p { max-width: 38em; }
    .part strong { font-weight: 700; background: linear-gradient(transparent 62%, color-mix(in srgb, var(--accent) 40%, transparent) 62%); }
    ol.steps { list-style: none; counter-reset: s; margin-bottom: .5rem; }
    ol.steps li { counter-increment: s; display: flex; gap: 1rem; padding: .5rem 0; border-top: 1px solid var(--rule); font-size: 1.05rem; }
    ol.steps li::before { content: counter(s, decimal-leading-zero); font-family: var(--mono); font-size: .72rem; color: var(--mute); padding-top: .3rem; }
    ol.steps li.hl { font-weight: 700; }
    ol.steps li.hl::after { content: attr(data-tag); margin-left: auto; font-family: var(--mono); font-size: .66rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; background: var(--accent); color: var(--bg); padding: .15rem .45rem; align-self: center; }
    .capt { font-family: var(--mono); font-size: .68rem; color: var(--mute); margin: .3rem 0 1.6rem; }
    .gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-bottom: .4rem; }
    .gal img { width: 100%; height: auto; display: block; border: 2px solid var(--rule); }
    .fail { background: var(--ink); color: var(--bg); padding: 1.1rem 1.3rem 1.3rem; margin: 0 0 1.5rem; }
    .fail h4 { font-family: var(--mono); font-size: .72rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: .35rem; }
    .fail p { font-size: 1.02rem; }
    .stack { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; }
    .stack li { font-family: var(--mono); font-size: .7rem; border: 2px solid var(--rule); padding: .1rem .5rem; }

    .row { display: grid; grid-template-columns: 1fr 1.5fr auto; gap: 1rem 2rem; align-items: baseline; padding: 1.1rem 0; border-top: 2px solid var(--rule); }
    .row:last-child { border-bottom: 2px solid var(--rule); }
    .row h3 { font-size: 1.35rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; }
    .row p { color: var(--mute); }
    .row a.go { text-decoration: none; border-bottom: 2px solid var(--accent); white-space: nowrap; }
    .row a.go:hover { background: var(--accent); color: var(--bg); }
    .xp { display: grid; grid-template-columns: 11rem 1fr 1.5fr; gap: 1rem 2.5rem; padding: 1.5rem 0; border-top: 2px solid var(--rule); }
    .xp:last-child { border-bottom: 2px solid var(--rule); }
    .xp .d { color: var(--mute); }
    .xp h3 { font-size: 1.6rem; font-weight: 750; letter-spacing: -.03em; line-height: 1.1; }
    .xp .org { color: var(--accent); font-weight: 600; }
    .xp ul { margin-left: 1.1rem; color: var(--mute); }
    .xp li { margin-bottom: .25rem; }
    .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 0 3rem; }
    .sk { border-top: 2px solid var(--rule); padding: .8rem 0 1.6rem; }
    .sk h3 { font-family: var(--mono); font-size: .74rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--mute); margin-bottom: .4rem; }
    .sk p { font-size: 1.15rem; line-height: 1.45; }
    .about { display: grid; grid-template-columns: 7fr 5fr; gap: 2rem 4rem; }
    .about .big { font-size: clamp(1.6rem, 3.4vw, 2.7rem); line-height: 1.15; font-weight: 550; letter-spacing: -.025em; }
    .about p.sm { color: var(--mute); margin-bottom: .9rem; max-width: 34em; }
    .about strong { color: var(--ink); }
    .mail { display: block; font-size: clamp(1.7rem, 6.6vw, 5.6rem); font-weight: 800; letter-spacing: -.045em; line-height: 1; overflow-wrap: anywhere; text-decoration: none; border-bottom: 6px solid var(--accent); padding-bottom: .2rem; }
    .mail:hover { color: var(--accent); }
    .links { display: flex; flex-wrap: wrap; gap: .6rem 2rem; margin-top: 1.6rem; }
    .links a { text-decoration: none; border-bottom: 2px solid var(--rule); }
    .links a:hover { color: var(--accent); border-bottom-color: var(--accent); }
    footer { margin-top: 5rem; border-top: 2px solid var(--rule); padding: 1.2rem 0 2.5rem; color: var(--mute); display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

    @media (max-width: 900px) {
        .hero-grid, .pbody, .about, .skills { grid-template-columns: 1fr; }
        .row { grid-template-columns: 1fr; gap: .2rem; }
        .xp { grid-template-columns: 1fr; gap: .4rem; }
        .top nav { display: none; }
        details.proj > summary { grid-template-columns: 3rem minmax(0, 1fr) 1.6rem; }
        .pkind { display: none; }
        .pfind { grid-column: 2 / 3; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
</style>
</head>
<body>
<header class="top">
    <div class="wrap top-in">
        <a class="brand" href="#top">A. Siddiqui</a>
        <nav class="mono" aria-label="Sections">
            <a href="#work">Work</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#about">About</a><a href="#contact">Contact</a>
        </nav>
        <button class="tbtn mono" id="themeToggle" type="button" aria-label="Switch colour theme"><span id="themeLabel">Dark</span></button>
    </div>
</header>

<main id="top">
    <div class="wrap">
        <section class="hero" aria-label="Introduction">
            <h1><span>{{ P.first }}</span><span class="l2">{{ P.last }}.</span></h1>
            <div class="hero-grid">
                <p class="lead">{{ P.lead.replace(P.lead_em, '<em>' ~ P.lead_em ~ '</em>')|safe }}</p>
                <div class="meta mono">
                    <div><span class="k">Role</span>{{ P.role }}</div>
                    <div><span class="k">Now</span>ML Engineer (contract), Rezinx</div>
                    <div><span class="k">Elsewhere</span><a href="{{ P.resume }}" download>Resume (PDF)</a> &nbsp; <a href="{{ P.github }}" target="_blank" rel="noopener">GitHub</a> &nbsp; <a href="{{ P.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></div>
                </div>
            </div>
        </section>
        <div class="ticker mono" aria-hidden="true">Local LLMs <b>/</b> RAG that quotes its sources <b>/</b> On-device vision and speech <b>/</b> Measured, with the failures included <b>/</b> Local LLMs <b>/</b> RAG that quotes its sources</div>

        <section class="sec" id="work">
            <div class="sec-h"><h2>Four projects, failures included</h2><span class="mono">(04) open one</span></div>
            {% for p in PROJECTS %}
            <details class="proj" id="{{ p.id }}"{% if loop.first %} open{% endif %}>
                <summary>
                    <span class="pnum">{{ p.n }}</span>
                    <span><span class="pname">{{ p.name }}</span><span class="ptag">{{ p.tag }}</span></span>
                    <span class="pkind mono">{{ p.kind }}</span>
                    <span class="pm" aria-hidden="true"></span>
                    <span class="pfind">{{ p.find }}</span>
                </summary>
                <div class="pbody">
                    <div>
                        <p class="problem">{{ p.problem }}</p>
                        <div class="btns mono">{% for label, url in p.links %}<a href="{{ url }}" target="_blank" rel="noopener">{{ label }} ↗</a>{% endfor %}</div>
                        <div class="part"><h4>Built</h4><p>{{ p.built|safe }}</p></div>
                        <div class="part"><h4>Measured</h4><p>{{ p.measured|safe }}</p></div>
                        {% if p.limits %}<div class="part"><h4>Limits</h4><p>{{ p.limits }}</p></div>{% endif %}
                    </div>
                    <div>
                        {% if p.steps %}
                        <ol class="steps" aria-label="Pipeline">{% for text, hl in p.steps %}<li{% if hl %} class="hl" data-tag="{{ p.hl_label }}"{% endif %}>{{ text }}</li>{% endfor %}</ol>
                        <p class="capt">{{ p.steps_caption }}</p>
                        {% endif %}
                        {% if p.gallery %}
                        <div class="gal">{% for src, alt in p.gallery %}<img src="{{ src }}" width="640" height="640" loading="lazy" alt="{{ alt }}" />{% endfor %}</div>
                        <p class="capt">{{ p.gallery_caption }}</p>
                        {% endif %}
                        <div class="fail" role="note"><h4>Did not work</h4><p>{{ p.fail }}</p></div>
                        <ul class="stack">{% for s in p.stack %}<li>{{ s }}</li>{% endfor %}</ul>
                    </div>
                </div>
            </details>
            {% endfor %}

            <div class="sec-h" style="margin-top:4rem"><h2 style="font-size:clamp(1.6rem,3.6vw,2.6rem)">Also built</h2></div>
            {% for a in ALSO %}
            <div class="row"><h3>{{ a.name }}</h3><p>{{ a.text }}</p><a class="go mono" href="{{ a.url }}" target="_blank" rel="noopener">GitHub ↗</a></div>
            {% endfor %}
        </section>

        <section class="sec" id="experience">
            <div class="sec-h"><h2>Where I have worked</h2></div>
            {% for e in EXPERIENCE %}
            <div class="xp">
                <div class="d mono">{{ e.when }}<br />{{ e.place }}</div>
                <div><h3>{{ e.role }}</h3><span class="org">{{ e.org }}</span></div>
                <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
            </div>
            {% endfor %}
        </section>

        <section class="sec" id="skills">
            <div class="sec-h"><h2>What I work with</h2></div>
            <div class="skills">{% for label, text in SKILLS %}<div class="sk"><h3>{{ label }}</h3><p>{{ text }}</p></div>{% endfor %}</div>
        </section>

        <section class="sec" id="about">
            <div class="sec-h"><h2>What I care about</h2></div>
            <div class="about">
                <p class="big">{{ ABOUT[0] }}</p>
                <div>{% for para in ABOUT[1:] %}<p class="sm">{{ para|safe }}</p>{% endfor %}</div>
            </div>
        </section>

        <section class="sec" id="contact">
            <div class="sec-h"><h2>Say hello</h2><span class="mono">email is quickest</span></div>
            <a class="mail" href="mailto:{{ P.email }}">{{ P.email }}</a>
            <div class="links mono"><a href="{{ P.github }}" target="_blank" rel="noopener">GitHub ↗</a><a href="{{ P.linkedin }}" target="_blank" rel="noopener">LinkedIn ↗</a><a href="{{ P.resume }}" download>Resume (PDF) ↓</a></div>
        </section>

        <footer class="mono"><span>M. Ahmad Siddiqui · ML Engineer</span><span>Updated October 2026</span></footer>
    </div>
</main>
{% include "_scripts.html" %}
<script>
    (function () {
        function openHash() { var el = location.hash && document.querySelector("details" + location.hash); if (el) el.open = true; }
        openHash(); window.addEventListener("hashchange", openHash);
        var nav = {}; document.querySelectorAll(".top nav a").forEach(function (a) { nav[a.getAttribute("href").slice(1)] = a; });
        function setActive(id) {
            if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) id = "contact";
            Object.keys(nav).forEach(function (k) { if (k === id) nav[k].setAttribute("aria-current", "true"); else nav[k].removeAttribute("aria-current"); });
        }
        if ("IntersectionObserver" in window) {
            var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) setActive(e.target.id); }); }, { rootMargin: "-30% 0px -60% 0px" });
            Object.keys(nav).forEach(function (k) { var s = document.getElementById(k); if (s) io.observe(s); });
            addEventListener("scroll", function () { if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) setActive("contact"); }, { passive: true });
        }
    })();
</script>
</body>
</html>
